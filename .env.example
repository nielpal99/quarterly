# Copy to .env; never commit secrets.
LLAMA_CLOUD_API_KEY=
QUARTERLY_DATA_DIR=data

# Optional structured extraction; table mapping works without these.
OPENAI_API_KEY=
QUARTERLY_EXTRACTION_MODEL=gpt-5.6-terra

# Optional web discovery; SEC discovery does not need an API key.
EXA_API_KEY=
# Set to an application name and real contact email for SEC requests.
SEC_USER_AGENT=
